@{
    ViewData["Title"] = "Головна";
}
<div class="p-5 mb-4 bg-light rounded-3 border">
    <h1 class="display-5 fw-bold">AutoHub ERP</h1>
    <p class="fs-5">Інформаційна система керування автосалоном: клієнти, автомобілі, довідники й аналітика.</p>
    @if (User.Identity?.IsAuthenticated != true)
    {
        <a asp-controller="Account" asp-action="Login"
           class="btn btn-primary btn-lg">Увійти до системи</a>
    }
    else
    {

        <a asp-controller="Cars" asp-action="Index"
           class="btn btn-primary btn-lg">Відкрити каталог</a>
    }
</div>
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Клієнти</div>
                <div class="display-6">@ViewBag.CustomerCount</div><a asp-controller="Customers"
                                                                      asp-action="Index">Переглянути</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Автомобілі</div>
                <div class="display-6">@ViewBag.CarCount</div><a asp-controller="Cars"
                                                                 asp-action="Index">Переглянути</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">У наявності</div>
                <div class="display-6">@ViewBag.AvailableCount</div><a asp-controller="Reports" asp-action="Index">Звіти
                й аналітика</a>
            </div>
        </div>
    </div>
</div>