<!DOCTYPE html>
<html lang="uk">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoHub.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AutoHub.Web.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">AutoHub ERP</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home"
                                                    asp-action="Index">Головна</a></li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Cars" asp-action="Index">Автомобілі</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="CarBrands" asp-action="Index">Марки</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Customers" asp-action="Index">Клієнти</a>
                            </li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Reports"
                                                        asp-action="Index">Звіти</a></li>
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="Info"
                                                            asp-action="Help">Довідка</a></li>
                                    <li class="nav-item"><a class="nav-link text-dark" asp-controller="Info" asp-action="About">Про
                                        програму</a></li>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <li class="nav-item"><a class="nav-link text-dark"
                                                                        asp-controller="Admin" asp-action="Index">Адміністрування</a></li>
                                            }
                                        </ul>
                                        <ul class="navbar-nav">
                                            @if (User.Identity?.IsAuthenticated == true)
                                            {
                                                <li class="nav-item"><span
                                                    class="nav-link">@User.Identity.Name
                                                    (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span></li>
                                                    <li class="nav-item">
                                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline"><button
                                                            class="btn btn-outline-secondary btn-sm mt-1" type="submit">Вийти</button></form>
                                                        </li>
                                                    } else
                                                    {

                                                        <li class="nav-item"><a class="nav-link" asp-controller="Account"
                                                                                    asp-action="Login">Увійти</a></li>
                                                        }
                                                    </ul>
                                                </div>
                                            </div>
                                        </nav>
                                    </header>
                                    <div class="container">
                                        <main role="main" class="pb-3">
                                            @RenderBody()
                                        </main>
                                    </div>

                                    <footer class="border-top footer text-muted">
                                        <div class="container">
                                            &copy; 2026 - AutoHub ERP - <a asp-controller="Info" asp-action="About">Про програму</a>
                                        </div>
                                    </footer>
                                    <script src="~/lib/jquery/dist/jquery.min.js"></script>
                                    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
                                    <script src="~/js/site.js" asp-append-version="true"></script>
                                    @await RenderSectionAsync("Scripts", required: false)
                                </body>

                            </html>
