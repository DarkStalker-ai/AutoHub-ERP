@model AutoHub.Web.Models.Car

@{
    ViewData["Title"] = "Add Car";
}

<h1>Add Car</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Model" class="form-label"></label>
                <input asp-for="Model" class="form-control" />
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CarBrandId" class="form-label"></label>
                <select asp-for="CarBrandId" asp-items="ViewBag.CarBrandId" class="form-select">
                    <option value="">Select a brand</option>
                </select>
                <span asp-validation-for="CarBrandId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ProductionYear" class="form-label"></label>
                <input asp-for="ProductionYear" type="number" class="form-control" />
                <span asp-validation-for="ProductionYear" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Color" class="form-label"></label>
                <input asp-for="Color" class="form-control" />
                <span asp-validation-for="Color" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Available">У наявності</option>
                    <option value="Reserved">Зарезервовано</option>
                    <option value="Sold">Продано</option>
                    <option value="Service">На обслуговуванні</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Save
            </button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
