@model AutoHub.Web.Models.Car

@{
    ViewData["Title"] = "Delete Car";
}

<h1>Delete Car</h1>

<h4>Are you sure you want to delete this car?</h4>

<div class="card mt-3">
    <div class="card-body">
        <h5>@Model.Model</h5>
        <hr />

        <dl class="row  
            <dt class=" col-sm-3">Brand (ID)</dt>
            <dd class="col-sm-9">@Model.CarBrandId</dd>

            <dt class="col-sm-3">Production Year</dt>
            <dd class="col-sm-9">@Model.ProductionYear</dd>

            <dt class="col-sm-3">Color</dt>
            <dd class="col-sm-9">@Model.Color</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Price</dt>
            <dd class="col-sm-9">
                @Model.Price.ToString("N2") грн
            </dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">
                Видалити
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Скасувати
            </a>
        </form>
    </div>
</div>