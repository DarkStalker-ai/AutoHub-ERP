@model IEnumerable<AutoHub.Web.Models.AppUser>
@{
    ViewData["Title"] = "Користувачі";
}
<h1>Користувачі системи</h1>
<p><a class="btn btn-primary" asp-action="CreateUser">Додати користувача</a></p>
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}
<table class="table table-striped">
    <thead>
        <tr>
            <th>Логін</th>
            <th>Роль</th>
            <th>Стан</th>
            <th>Створено (UTC)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Username</td>
                <td>@u.Role</td>
                <td>@(u.IsActive ? "Активний" : "Вимкнений")</td>
                <td>@u.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <form asp-action="ToggleUser" method="post"><input type="hidden" name="id" value="@u.Id" /><button
                        class="btn btn-sm btn-outline-secondary" type="submit">@(u.IsActive ? "Деактивувати" :
                        "Активувати")</button></form>
                    </td>
                </tr>
            }
        </tbody>
    </table>