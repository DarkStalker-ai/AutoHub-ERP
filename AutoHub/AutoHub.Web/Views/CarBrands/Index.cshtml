@model IEnumerable<AutoHub.Web.Models.CarBrand>

@{
    ViewData["Title"] = "Car Brands";
}

<h1>Car Brands</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Add New Brand
    </a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Identificator</th>
            <th>Brand Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var brand in Model)
        {
            <tr>
                <td>@brand.Id</td>
                <td>@brand.Name</td>
                <td>
                    <a asp-action="Details" asp-route-id="@brand.Id" class="btn btn-sm btn-outline-secondary">
                        Details
                    </a>
                    <a asp-action="Edit" asp-route-id="@brand.Id" class="btn btn-sm btn-outline-primary">
                        Edit
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Delete" asp-route-id="@brand.Id" class="btn btn-sm btn-outline-danger">
                            Delete
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>