@model AutoHub.Web.Controllers.ReportsViewModel
@{ ViewData["Title"] = "Звіти й аналітика"; }
<h1>Звіти й аналітика</h1><p class="text-muted">Зведені показники поточного стану бази даних.</p>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="card"><div class="card-body"><div>Клієнти</div><strong class="display-6">@Model.CustomerCount</strong></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><div>Автомобілі</div><strong class="display-6">@Model.CarCount</strong></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><div>У наявності</div><strong class="display-6">@Model.AvailableCount</strong></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><div>Продано</div><strong class="display-6">@Model.SoldCount</strong></div></div></div></div>
<div class="card mb-4"><div class="card-body"><h2 class="h5">Орієнтовна вартість непроданих автомобілів</h2><p class="display-6">@Model.InventoryValue.ToString("N2") грн</p></div></div>
<h2 class="h4">Розподіл автомобілів за марками</h2><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Марка</th><th>Кількість</th><th>Сумарна вартість</th><th>Візуалізація кількості</th></tr></thead><tbody>@foreach(var b in Model.ByBrand){<tr><td>@b.Brand</td><td>@b.Count</td><td>@b.Value.ToString("N2") грн</td><td><div class="progress" role="progressbar" aria-label="Кількість @b.Brand" aria-valuenow="@b.Count" aria-valuemin="0" aria-valuemax="@Math.Max(1, Model.ByBrand.Max(x => x.Count))"><div class="progress-bar" style="width:@(100.0*b.Count/Math.Max(1,Model.ByBrand.Max(x=>x.Count)))%">@b.Count</div></div></td></tr>}</tbody></table></div>
<button class="btn btn-outline-secondary" onclick="window.print()" type="button">Друкувати звіт</button>
